<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Quản lý tài khoản</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<header class="header">
  <a href="/" class="logo">Sports Shop</a>

  <nav>
    <a href="/">Trang chủ</a>
    <a href="/products">Sản phẩm</a>
    <a href="/admin/users">Quản lý tài khoản</a>
    <a href="/admin/products">Quản lý sản phẩm</a>
    <a href="/auth/logout">Đăng xuất</a>
  </nav>
</header>

<main class="page-wrap">
  <h1>Quản lý tài khoản</h1>

  <table>
    <tr>
      <th>ID</th>
      <th>Họ tên</th>
      <th>Email</th>
      <th>SĐT</th>
      <th>Địa chỉ</th>
      <th>Vai trò</th>
      <th>Cấp quyền</th>
      <th>Xóa</th>
    </tr>

    <% users.forEach(u => { %>
      <tr>
        <td><%= u.id %></td>
        <td><%= u.full_name %></td>
        <td><%= u.email %></td>
        <td><%= u.phone || '' %></td>
        <td><%= u.address || '' %></td>
        <td><strong><%= u.role %></strong></td>

        <td>
          <form action="/admin/users/<%= u.id %>/role" method="POST">
            <select name="role" class="auth-select">
              <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>Người dùng</option>
              <option value="seller" <%= u.role === 'seller' ? 'selected' : '' %>>Người bán</option>
              <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
            </select>

            <button type="submit">Lưu</button>
          </form>
        </td>

        <td>
          <form action="/admin/users/<%= u.id %>/delete" method="POST">
            <button type="submit" onclick="return confirm('Bạn có chắc muốn xóa tài khoản này?')">
              Xóa
            </button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
</main>

</body>
</html>