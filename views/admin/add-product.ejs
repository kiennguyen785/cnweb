<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Admin - Thêm sản phẩm</title>
  <link rel="stylesheet" href="/stylesheets/style.css">

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f6fa;
      margin: 0;
      padding: 0;
    }

    .admin-header {
      background: #111827;
      color: #fff;
      padding: 16px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .admin-header a {
      color: #fff;
      text-decoration: none;
      margin-left: 18px;
      font-weight: bold;
    }

    .container {
      width: 760px;
      margin: 30px auto;
      background: #fff;
      padding: 26px;
      border-radius: 10px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }

    h1 {
      margin-top: 0;
      color: #111827;
    }

    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-weight: bold;
      color: #374151;
    }

    input,
    textarea,
    select {
      width: 100%;
      padding: 10px;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      font-size: 15px;
      box-sizing: border-box;
    }

    textarea {
      min-height: 90px;
      resize: vertical;
    }

    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;
    }

    .checkbox-row input {
      width: auto;
    }

    .actions {
      display: flex;
      gap: 12px;
      margin-top: 20px;
    }

    button {
      padding: 11px 18px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
      font-size: 15px;
    }

    .btn-save {
      background: #2563eb;
      color: white;
    }

    .btn-back {
      display: inline-block;
      padding: 11px 18px;
      background: #6b7280;
      color: white;
      text-decoration: none;
      border-radius: 6px;
      font-weight: bold;
    }

    .error {
      background: #fee2e2;
      color: #b91c1c;
      padding: 12px;
      border-radius: 6px;
      margin-bottom: 16px;
      font-weight: bold;
    }

    .note {
      color: #6b7280;
      font-size: 14px;
      margin-top: 5px;
    }
  </style>
</head>

<body>
  <div class="admin-header">
    <div>
      <strong>Admin Panel</strong>
    </div>

    <div>
      <a href="/">Trang chủ</a>
      <a href="/admin/users">Quản lý tài khoản</a>
      <a href="/admin/products">Quản lý sản phẩm</a>
      <a href="/auth/logout">Đăng xuất</a>
    </div>
  </div>

  <div class="container">
    <h1>Thêm sản phẩm</h1>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form action="/admin/products/add" method="POST">
      <div class="form-group">
        <label for="product_name">Tên sản phẩm</label>
        <input
          type="text"
          id="product_name"
          name="product_name"
          placeholder="Nhập tên sản phẩm"
          required
        >
      </div>

      <div class="form-group">
        <label for="brand_id">Brand ID</label>
        <input
          type="number"
          id="brand_id"
          name="brand_id"
          placeholder="Ví dụ: 1"
          required
        >
        <div class="note">Nhập ID thương hiệu đang có trong database.</div>
      </div>

      <div class="form-group">
        <label for="category_id">Category ID</label>
        <input
          type="number"
          id="category_id"
          name="category_id"
          placeholder="Ví dụ: 1"
          required
        >
        <div class="note">Nhập ID danh mục đang có trong database.</div>
      </div>

      <div class="form-group">
        <label for="seller_id">Gán cho người bán</label>
        <select id="seller_id" name="seller_id">
          <option value="">-- Chưa gán người bán --</option>

          <% if (sellers && sellers.length > 0) { %>
            <% sellers.forEach(seller => { %>
              <option value="<%= seller.user_id %>">
                <%= seller.full_name %> - <%= seller.email %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div class="form-group">
        <label for="quantity">Số lượng</label>
        <input
          type="number"
          id="quantity"
          name="quantity"
          min="0"
          value="0"
        >
      </div>

      <div class="form-group">
        <label for="image_url">Đường dẫn ảnh sản phẩm</label>
        <input
          type="text"
          id="image_url"
          name="image_url"
          placeholder="/images/product.jpg hoặc link ảnh"
        >
      </div>

      <div class="form-group">
        <label for="description">Mô tả</label>
        <textarea
          id="description"
          name="description"
          placeholder="Nhập mô tả sản phẩm"
        ></textarea>
      </div>

      <div class="form-group">
        <label for="specifications">Thông số kỹ thuật</label>
        <textarea
          id="specifications"
          name="specifications"
          placeholder="Nhập thông số kỹ thuật"
        ></textarea>
      </div>

      <div class="checkbox-row">
        <input type="checkbox" id="is_promotion" name="is_promotion">
        <label for="is_promotion">Sản phẩm khuyến mãi</label>
      </div>

      <div class="checkbox-row">
        <input type="checkbox" id="is_active" name="is_active" checked>
        <label for="is_active">Đang bán / hiển thị</label>
      </div>

      <div class="actions">
        <button type="submit" class="btn-save">Thêm sản phẩm</button>
        <a href="/admin/products" class="btn-back">Quay lại</a>
      </div>
    </form>
  </div>
</body>
</html>