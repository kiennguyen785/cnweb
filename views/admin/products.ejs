<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Quản lý sản phẩm</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

<header class="header">

  <a href="/" class="logo">
    Sports Shop
  </a>

  <nav>
    <a href="/">Trang chủ</a>

    <a href="/admin/users">
      Quản lý tài khoản
    </a>

    <a href="/admin/products">
      Quản lý sản phẩm
    </a>

    <a href="/auth/logout">
      Đăng xuất
    </a>
  </nav>

</header>

<main class="page-wrap">

  <h1>Quản lý sản phẩm</h1>
    <div style="margin-bottom:20px;">
        <a href="/admin/products/add">
            <button>
            + Thêm sản phẩm
            </button>
        </a>
    </div>
  <table>

    <tr>
      <th>ID</th>
      <th>Ảnh</th>
      <th>Tên sản phẩm</th>
      <th>Danh mục</th>
      <th>Giá</th>
      <th>Số lượng</th>
      <th>Seller ID</th>
      <th>Xóa</th>
    </tr>

    <% products.forEach(p => { %>

      <tr>

        <td>
          <%= p.id %>
        </td>

        <td>
          <img
            src="<%= p.image_url %>"
            style="
              width:70px;
              height:70px;
              object-fit:cover;
              border-radius:10px;
            "
          >
        </td>

        <td>
          <%= p.product_name %>
        </td>

        <td>
          <%= p.category %>
        </td>

        <td>
          <strong>
            <%= Number(p.price)
              .toLocaleString('vi-VN') %> đ
          </strong>
        </td>
        <td>
             <%= p.quantity %>
        </td>
        <td>
          <%= p.seller_id || '' %>
        </td>

        <td>

          <form
            action="/admin/products/<%= p.id %>/delete"
            method="POST"
          >

            <button
              type="submit"
              onclick="
                return confirm(
                  'Xóa sản phẩm này?'
                )
              "
            >
              Xóa
            </button>

          </form>

        </td>

      </tr>

    <% }) %>

  </table>

</main>

</body>
</html>